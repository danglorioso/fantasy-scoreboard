// Copy this file to Secrets.swift (same folder) and fill in your values.
// Secrets.swift is git-ignored, so your ESPN login never ends up on GitHub.
//
//   cp FantasyOverlay/Secrets.swift.example FantasyOverlay/Secrets.swift
//
// Leave the placeholders as-is to run in Demo mode.

enum Secrets {
    // From your league URL: https://fantasy.espn.com/football/league?leagueId=XXXXXXX
    static let leagueID = "YOUR_LEAGUE_ID"

    // Cookies from fantasy.espn.com while logged in (see README).
    static let espnS2 = "YOUR_ESPN_S2_COOKIE"
    static let swid = "{YOUR-SWID-INCLUDING-CURLY-BRACES}"
}
